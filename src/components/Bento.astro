---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/portrait/portrait-vfa.png';
import marconiPhoto from '../assets/work/marconi.jpg';
import { profile } from '../data/profile';
import { experiences } from '../data/experiences';
import { stackSummary, levelRank } from '../data/skills';
import { useT, fill, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

const sqlLines: { html: string; hl?: boolean }[] = [
  { html: `<i class="c">${t.bento.codeComment}</i>` },
  { html: '<b>SELECT</b> c.company_name,' },
  { html: '       <b>COUNT</b>(o.id)    <b>AS</b> orders,' },
  { html: '       <b>SUM</b>(o.total)   <b>AS</b> revenue' },
  { html: '<b>FROM</b>   customers c<span class="caret"></span>', hl: true },
  { html: '<b>JOIN</b>   orders o <b>ON</b> o.customer_id = c.id' },
  { html: "<b>WHERE</b>  o.order_date &gt;= <s>'2024-01-01'</s>" },
  { html: '<b>GROUP BY</b> c.company_name' },
  { html: '<b>ORDER BY</b> revenue <b>DESC</b>;' },
];

/* Schede rapide: fatti dai dati, testo dal dizionario (ore di tirocinio = esperienza passata) */
const order = ['ips', 'sunfai', 'marconi'] as const;
const miniCards = order.map((slug) => {
  const e = experiences.find((x) => x.slug === slug)!;
  return {
    href: localizePath(`/esperienza-${e.slug}`, locale),
    name: e.orgShort,
    year: e.year,
    detail: e.kind === 'internship' ? fill(t.bento.miniHours, { hours: e.hours ?? '' }) : fill(t.bento.miniDiploma, { grade: e.grade ?? '' }),
  };
});
const levelLabels = t.profile.levels;
const modeIcons = { remote: 'home', licence: 'car' } as const;
const ar = t.arrange;
const grip = (id: keyof typeof ar.names) => fill(ar.handle, { name: ar.names[id] });
---

<section id="in-breve" class="brief bleed" aria-labelledby="brief-title" data-section data-surface="dark">
  <div class="shell">
    <header class="brief__head">
      <h2 id="brief-title" class="t-h2" data-reveal="title">{t.bento.title}</h2>
      <div class="brief__side" data-reveal="fade">
        <p class="brief__intro">{t.bento.intro}</p>
        <div class="arrange" data-arrange>
          <button class="arrange__btn" type="button" aria-expanded="false" aria-controls="arrange-panel" data-arrange-btn>
            <Icon name="dots" />
            <span class="visually-hidden">{ar.menu}</span>
          </button>
          <div class="arrange__panel" id="arrange-panel" data-arrange-panel hidden>
            <p class="arrange__hint">{ar.hint}</p>
            <button class="arrange__reset" type="button" data-arrange-reset><Icon name="route" />{ar.reset}</button>
          </div>
        </div>
      </div>
    </header>
    <div class="drag-hint" data-arrange-tip hidden>
      <span class="drag-hint__grip" aria-hidden="true"><span></span></span>
      <p class="drag-hint__text"><span class="drag-hint__mouse">{ar.dragHint}</span><span class="drag-hint__touch">{ar.dragHintTouch}</span></p>
      <button class="drag-hint__ok" type="button" data-arrange-tip-close>{ar.dismiss}</button>
    </div>
    <p id="arrange-hint" class="visually-hidden">{ar.hint}</p>
    <p class="visually-hidden" aria-live="polite" data-bento-live></p>

    <div
      class="bento"
      data-stagger
      data-bento
      data-msg-picked={ar.picked}
      data-msg-moved={ar.moved}
      data-msg-dropped={ar.dropped}
      data-msg-cancelled={ar.cancelled}
      data-msg-reset={ar.resetDone}
    >
      <!-- Stack per livello -->
      <article class="tile t-stack sig" data-sig="1" data-bento-id="stack" data-size="tall" data-bento-name={ar.names.stack} aria-labelledby="t-stack-title">
        <button class="grip" type="button" data-grip aria-label={grip('stack')} aria-describedby="arrange-hint"><span aria-hidden="true"></span></button>
        <div class="panel t-stack__menu">
          <div class="t-stack__head">
            <h3 id="t-stack-title">{t.bento.stackTitle}</h3>
          </div>
          {
            stackSummary.map((g, gi) => (
              <div class="t-stack__group">
                {gi > 0 && <hr />}
                <p class="t-stack__label">
                  <span>{levelLabels[g.level].label}</span>
                  <span class="lvl" data-rank={levelRank[g.level]} aria-hidden="true"><i /><i /><i /></span>
                </p>
                <ul role="list">{g.items.map((it) => <li>{it}</li>)}</ul>
              </div>
            ))
          }
          <a class="t-stack__more" href="#profilo">{t.bento.allSkills} <Icon name="arrowDown" /></a>
        </div>
      </article>

      <!-- Query di esempio -->
      <article class="tile t-code sig" data-sig="1" data-bento-id="sql" data-size="small" data-bento-name={ar.names.sql} aria-labelledby="t-code-title">
        <button class="grip" type="button" data-grip aria-label={grip('sql')} aria-describedby="arrange-hint"><span aria-hidden="true"></span></button>
        <div class="win">
          <div class="win__bar">
            <span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <h3 id="t-code-title" class="win__tab">{t.bento.codeFile}</h3>
            <span class="win__badge">SQL Server</span>
          </div>
          <pre class="code" tabindex="0" aria-label={t.bento.codeAria}><code>{
            sqlLines.map((l, i) => (
              <span class:list={['ln', { 'ln--hl': l.hl }]}><span class="ln__n" aria-hidden="true">{i + 1}</span><span set:html={l.html} /></span>
            ))
          }</code></pre>
        </div>
      </article>

      <!-- Ultima esperienza -->
      <article class="tile t-recap sig" data-sig="3" data-door data-glow data-bento-id="recap" data-size="small" data-bento-name={ar.names.recap} aria-labelledby="t-recap-title">
        <button class="grip" type="button" data-grip aria-label={grip('recap')} aria-describedby="arrange-hint"><span aria-hidden="true"></span></button>
        <div class="t-recap__bar">
          <span class="pill"><Icon name="bolt" /><span class="pill__text">{t.bento.recapLabel}</span></span>
          <span class="t-recap__icons" aria-hidden="true">
            <span class="sq"><Icon name="chart" /></span>
            <span class="sq"><Icon name="flow" /></span>
          </span>
        </div>
        <h3 id="t-recap-title" class="t-recap__title">{t.bento.recapTitle}</h3>
        <p class="t-recap__text">{t.bento.recapText}</p>
        <span class="door-arrow" aria-hidden="true"><Icon name="arrowUpRight" /></span>
        <a class="stretched" href={localizePath('/esperienza-sunfai', locale)}><span class="visually-hidden">{t.bento.recapOpen}</span></a>
      </article>

      <!-- Ritratto e disponibilità -->
      <article class="tile t-portrait sig" data-sig="1" data-bento-id="portrait" data-size="tall" data-bento-name={ar.names.portrait} aria-labelledby="t-portrait-title">
        <button class="grip" type="button" data-grip aria-label={grip('portrait')} aria-describedby="arrange-hint"><span aria-hidden="true"></span></button>
        <span class="t-portrait__room" aria-hidden="true"></span>
        <Picture
          src={portrait}
          alt={t.hero.portraitAlt}
          formats={['webp']}
          quality={88}
          widths={[420, 640, 900]}
          sizes="(max-width: 700px) 80vw, (max-width: 1199px) 40vw, 320px"
          class="t-portrait__img"
          loading="lazy"
        />
        <span class="pill pill--glass t-portrait__loc"><Icon name="pin" /><span class="pill__text">{profile.base.city} ({profile.base.province})</span></span>
        <div class="glass t-portrait__card">
          <p id="t-portrait-title" class="t-portrait__status"><span class="signal-dot" aria-hidden="true"></span>{t.availability.status}</p>
          <p class="t-portrait__text">{t.availability.tile}</p>
          <div class="t-portrait__row">
            <a class="btn btn--light btn--sm" data-nudge="right" href="#contatti">{t.hero.writeMe}</a>
            <a class="btn btn--dark btn--sm" href={profile.contacts.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </div>
        </div>
      </article>

      <!-- Tile principale -->
      <article class="tile t-hello sig" data-sig="1" data-bento-id="hello" data-size="large" data-bento-name={ar.names.hello} aria-labelledby="t-hello-title">
        <button class="grip" type="button" data-grip aria-label={grip('hello')} aria-describedby="arrange-hint"><span aria-hidden="true"></span></button>
        <h3 id="t-hello-title" class="t-hello__big">
          <span class="dim">{t.bento.greeting}</span>
          {t.bento.hoursBefore} <strong>{fill(t.bento.hoursValue, { hours: profile.internshipHours })}</strong> {t.bento.hoursAfter}
        </h3>
        <ul class="t-hello__cards" role="list">
          {
            miniCards.map((c) => (
              <li>
                <a class="mini sig" data-sig="2" href={c.href}>
                  <span class="mini__top"><span class="mini__name">{c.name}</span><span class="mini__year">{c.year}</span></span>
                  <span class="mini__detail">{c.detail}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="t-hello__cta">
          <a class="btn btn--light" data-nudge="down" href="#esperienze"><Icon name="arrowDown" />{t.bento.viewExperiences}</a>
          <a class="btn btn--dark" data-nudge="down" href="#profilo"><Icon name="book" />{t.bento.readProfile}</a>
        </div>
      </article>

      <!-- Lingue -->
      <article class="tile t-lang sig" data-sig="1" data-bento-id="lang" data-size="small" data-bento-name={ar.names.lang} aria-labelledby="t-lang-title">
        <button class="grip" type="button" data-grip aria-label={grip('lang')} aria-describedby="arrange-hint"><span aria-hidden="true"></span></button>
        <div class="t-lang__in">
        <div class="t-lang__pill">
          <span class="t-lang__faces" aria-hidden="true">{profile.languages.map((l) => <span>{l.code}</span>)}</span>
          <h3 id="t-lang-title" class="t-lang__count">{t.bento.languagesCount}</h3>
        </div>
        <p class="t-lang__text">{t.bento.languagesText}</p>
        </div>
      </article>

      <!-- Contatti -->
      <article class="tile t-contact sig" data-sig="1" data-bento-id="contact" data-size="tall" data-bento-name={ar.names.contact} aria-labelledby="t-contact-title">
        <button class="grip" type="button" data-grip aria-label={grip('contact')} aria-describedby="arrange-hint"><span aria-hidden="true"></span></button>
        <div class="win__bar">
          <span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <h3 id="t-contact-title" class="win__title">{t.bento.contactTitle}</h3>
        </div>
        <div class="t-contact__field">
          <Icon name="mail" />
          <span class="t-contact__value">{profile.contacts.email}</span>
          <button class="sq sq--btn t-contact__copy" type="button" data-copy={profile.contacts.email} data-copy-status="copy-status-bento" data-msg-ok={t.contact.copiedMsg} data-msg-fail={t.contact.copyFail}>
            <Icon name="copy" />
            <span class="visually-hidden">{t.bento.copyEmail}</span>
          </button>
        </div>
        <p id="copy-status-bento" class="t-contact__status" role="status" aria-live="polite"></p>
        <ul class="t-contact__nav" role="list">
          <li><a class="is-active" href={`mailto:${profile.contacts.email}`}><Icon name="mail" /><span class="t-contact__name">{t.footer.email}</span><span class="t-contact__hint">{t.bento.writeHint}</span></a></li>
          <li><a class="ext" href={profile.contacts.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" /><span class="t-contact__name">LinkedIn</span><span class="t-contact__hint"><Icon name="arrowUpRight" class="ext__arrow" /></span></a></li>
          <li><a class="ext" href={profile.contacts.github} target="_blank" rel="noopener noreferrer"><Icon name="github" /><span class="t-contact__name">GitHub</span><span class="t-contact__hint"><Icon name="arrowUpRight" class="ext__arrow" /></span></a></li>
        </ul>
        <p class="tile__label t-contact__label">{t.bento.modesLabel}</p>
        <ul class="t-contact__modes" role="list">
          {profile.workModes.map((m) => <li><Icon name={modeIcons[m]} />{t.workModes[m]}</li>)}
        </ul>
      </article>

      <!-- Formazione (foto) -->
      <article class="tile t-photo sig" data-sig="3" data-door data-glow data-bento-id="photo" data-size="wide" data-bento-name={ar.names.photo} aria-labelledby="t-photo-title">
        <button class="grip" type="button" data-grip aria-label={grip('photo')} aria-describedby="arrange-hint"><span aria-hidden="true"></span></button>
        <Picture src={marconiPhoto} alt="" formats={['avif', 'webp']} widths={[640, 1100]} sizes="(max-width: 700px) 92vw, 640px" class="t-photo__img" loading="lazy" />
        <span class="t-photo__veil" aria-hidden="true"></span>
        <span class="pill pill--glass t-photo__tag"><Icon name="cap" /><span class="pill__text">{t.bento.educationTag}</span></span>
        <span class="door-arrow door-arrow--glass" aria-hidden="true"><Icon name="arrowUpRight" /></span>
        <div class="t-photo__stack">
          <div class="glass t-photo__card t-photo__card--back" aria-hidden="true"><p>{t.bento.hackathon}</p></div>
          <div class="glass t-photo__card">
            <p class="t-photo__org">ITI G. Marconi</p>
            <h3 id="t-photo-title" class="t-photo__title">{t.bento.educationTitle}</h3>
            <p class="t-photo__row"><span>{fill(t.bento.diploma, { grade: profile.grade })}</span><span class="pill pill--quiet"><Icon name="award" /><span class="pill__text">{t.bento.hackathonShort}</span></span></p>
          </div>
        </div>
        <a class="stretched" href={localizePath('/esperienza-marconi', locale)}><span class="visually-hidden">{t.bento.educationOpen}</span></a>
      </article>

      <!-- Curriculum -->
      <article class="tile t-cv sig" data-sig="3" data-door data-glow data-bento-id="cv" data-size="small" data-bento-name={ar.names.cv} aria-labelledby="t-cv-title">
        <button class="grip" type="button" data-grip aria-label={grip('cv')} aria-describedby="arrange-hint"><span aria-hidden="true"></span></button>
        <div class="t-cv__in">
        <div class="t-cv__sheets" aria-hidden="true">
          <span class="t-cv__sheet t-cv__sheet--dark"><i></i><i></i><i></i><i></i></span>
          <span class="t-cv__sheet"><b></b><i class="a"></i><i></i><i></i><i></i><i></i></span>
        </div>
        <div class="t-cv__text">
          <h3 id="t-cv-title" class="t-cv__title">{t.bento.cvTitle}</h3>
          <p class="t-cv__lead">{t.bento.cvText}</p>
        </div>
        <button class="btn btn--light btn--sm t-cv__btn" type="button" data-cv-open data-nudge="diag"><Icon name="arrowUpRight" />{t.bento.cvOpen}</button>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  .brief {
    position: relative;
    background: var(--room);
    color: var(--tile-ink);
    padding-block: clamp(5rem, 9vw, 8.5rem);
    transition: background-color 400ms var(--ease-out);
  }
  .brief::before {
    border-radius: inherit;
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(50% 60% at 50% 0%, rgb(255 255 255 / 0.035), transparent 70%);
  }
  .brief__head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px 60px;
    margin-bottom: clamp(2.5rem, 4vw, 3.75rem);
  }
  .brief__side { display: flex; align-items: flex-end; gap: 16px; min-width: 0; }
  .brief__intro { max-width: 40ch; color: var(--tile-ink-2); font-size: var(--t-small); }

  /* ---------- Opzioni della griglia (riordino) ---------- */
  .arrange { position: relative; flex: none; }
  .arrange__btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-2);
    color: var(--tile-ink-2);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    transition: color var(--motion-ui) var(--ease-standard), box-shadow var(--motion-ui) var(--ease-standard);
  }
  .arrange__btn :global(.icon) { width: 18px; height: 18px; }
  .arrange__btn:hover,
  .arrange__btn[aria-expanded='true'] { color: var(--tile-ink); box-shadow: inset 0 0 0 1px var(--accent-border); }
  .arrange__panel {
    position: absolute;
    z-index: 20;
    right: 0;
    top: calc(100% + 8px);
    width: min(20rem, calc(100vw - var(--gutter) * 2));
    display: grid;
    gap: 10px;
    padding: 14px;
    border-radius: var(--r-2);
    background: var(--room-2);
    box-shadow: var(--room-hi), var(--room-float);
  }
  .arrange__panel[hidden] { display: none; }
  .arrange__hint { font-size: 0.8125rem; line-height: 1.45; color: var(--tile-ink-2); }
  .arrange__reset {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 0.875rem;
    background: rgb(255 255 255 / 0.07);
  }
  .arrange__reset:hover:not(:disabled) { background: rgb(255 255 255 / 0.11); }
  .arrange__reset:disabled { opacity: 0.45; cursor: default; }
  .arrange__reset :global(.icon) { width: 16px; height: 16px; }

  /* ==========================================================================
     Griglia: ogni scheda ha una dimensione semantica (piccola, alta, larga, grande)
     e il flusso "dense" la colloca. L'ordine lo decide il DOM (riordinabile);
     ogni fascia di larghezza ha la sua griglia, non una desktop rimpicciolita.
     ========================================================================== */
  .bento {
    position: relative;
    display: grid;
    gap: 14px;
    min-width: 0;
    grid-auto-flow: row dense;
    /* Desktop ≥1200: quattro colonne, righe guidate dal contenuto */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.18fr) minmax(0, 1.18fr) minmax(0, 1fr);
    grid-auto-rows: minmax(180px, auto);
  }
  .tile[data-size='tall'] { grid-row: span 2; }
  .tile[data-size='wide'] { grid-column: span 2; }
  .tile[data-size='large'] { grid-column: span 2; grid-row: span 2; }

  /* Portatile stretto e tablet orizzontale: tre colonne */
  @media (max-width: 1199px) {
    .bento { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: minmax(190px, auto); }
    .t-recap,
    .t-cv { grid-column: span 2; }
  }
  /* Tablet verticale e tablet piccolo: due colonne, schede larghe dove il testo lo chiede */
  @media (max-width: 899px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; }
    .tile[data-size='tall'],
    .tile[data-size='large'] { grid-row: span 1; }
    .t-recap,
    .t-lang,
    .t-cv,
    .t-hello,
    .t-photo { grid-column: span 2; }
    .t-portrait { min-height: 400px; }
    .t-code { min-height: 290px; }
  }
  /* Telefono: una colonna, in flusso */
  @media (max-width: 579px) {
    .bento { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .bento > .tile { grid-column: auto; grid-row: auto; }
    .t-portrait { min-height: 440px; }
  }

  /* ---------- Tile ---------- */
  .tile {
    position: relative;
    min-width: 0;
    overflow: hidden;
    container-type: inline-size;
    border-radius: var(--r-tile);
    background: linear-gradient(180deg, var(--tile-hi), var(--tile));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.045);
    isolation: isolate;
  }

  /* ---------- Maniglia di riordino: tacca di precisione sul bordo superiore ---------- */
  .grip {
    position: absolute;
    z-index: 8;
    top: 0;
    left: 50%;
    width: 56px;
    height: 24px;
    margin-left: -28px;
    display: grid;
    place-items: center;
    border-radius: 0 0 var(--r-2) var(--r-2);
    color: var(--tile-ink-2);
    cursor: grab;
    touch-action: manipulation;
    -webkit-touch-callout: none;
    user-select: none;
    -webkit-user-select: none;
    opacity: 0.6;
    background: rgb(255 255 255 / 0.04);
    transition: opacity var(--motion-ui) var(--ease-standard), color var(--motion-ui) var(--ease-standard), background-color var(--motion-ui) var(--ease-standard);
  }
  /* sei punti, disegnati con un solo elemento */
  .grip span,
  .drag-hint__grip span {
    width: 18px;
    height: 8px;
    background-image: radial-gradient(circle, currentColor 1.4px, transparent 1.8px);
    background-size: 6px 4px;
    background-position: 0 0;
  }
  .tile:hover .grip,
  .grip:focus-visible,
  .bento[data-sorting] .grip { opacity: 1; background: rgb(255 255 255 / 0.08); }
  .grip:hover { color: var(--tile-ink); background: rgb(255 255 255 / 0.06); }
  .grip:focus-visible { outline-offset: -3px; border-radius: 0 0 var(--r-2) var(--r-2); color: var(--tile-ink); }
  @media (hover: none) { .grip { opacity: 0.8; } }
  .tile[data-picked] .grip,
  .tile.is-dragging .grip { opacity: 1; color: var(--room-accent); cursor: grabbing; }
  .tile[data-picked] { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 0 0 1px rgb(255 146 48 / 0.55); }

  /* Scheda sollevata: un filo più grande, ombra più netta, bordo più chiaro. Niente bagliore né rimbalzo. */
  .tile.is-dragging {
    z-index: 30;
    transform: translate3d(var(--dx, 0px), var(--dy, 0px), 0) scale(1.035) rotate(-0.6deg) !important;
    transition: box-shadow 180ms var(--ease-standard) !important;
    box-shadow: var(--room-hi), var(--room-drag);
    cursor: grabbing;
  }
  .bento[data-sorting] { user-select: none; -webkit-user-select: none; }
  /* Posto libero sotto la scheda sollevata: si vede dove andrà a cadere */
  .bento :global(.bento__ghost) {
    position: absolute;
    z-index: 0;
    border-radius: var(--r-tile);
    box-shadow: inset 0 0 0 1.5px rgb(255 146 48 / 0.45);
    background: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.025) 0 10px, transparent 10px 20px);
    opacity: 1 !important;
    transform: none !important;
    transition: left 260ms var(--ease-standard), top 260ms var(--ease-standard), width 260ms var(--ease-standard), height 260ms var(--ease-standard) !important;
    pointer-events: none;
  }
  .bento[data-sorting] > .tile:not(.is-dragging) { filter: brightness(0.92); transition: filter 200ms var(--ease-standard); }

  /* ---------- Suggerimento al primo accesso ---------- */
  .drag-hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    width: fit-content;
    max-width: 100%;
    margin: -1.25rem 0 1.5rem;
    padding: 8px 8px 8px 14px;
    border-radius: var(--r-2);
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 146 48 / 0.35);
    color: var(--tile-ink);
    font-size: 0.9375rem;
    transition: opacity 300ms var(--ease-standard), transform 300ms var(--ease-standard);
  }
  .drag-hint[hidden] { display: none; }
  .drag-hint[data-leaving] { opacity: 0; transform: translateY(-4px); }
  .drag-hint__grip { display: grid; place-items: center; width: 36px; height: 24px; border-radius: var(--r-1); background: rgb(255 255 255 / 0.08); color: var(--room-accent); }
  .drag-hint__text { min-width: 0; }
  .drag-hint__touch { display: none; }
  @media (hover: none) {
    .drag-hint__mouse { display: none; }
    .drag-hint__touch { display: inline; }
  }
  .drag-hint__ok { min-height: 36px; padding: 0 14px; border-radius: var(--r-1); background: rgb(255 255 255 / 0.1); font-size: 0.875rem; font-weight: 540; }
  .drag-hint__ok:hover { background: rgb(255 255 255 / 0.15); }
  .bento[data-sorting] .tile:not(.is-dragging) :is(a, button) { pointer-events: none; }
  .bento[data-arranged] > .tile { transition-delay: 0ms; }
  /* Passaggio del mouse: fisico e minimo — 2 px di sollevamento, bordo e ombra più netti */
  @media (hover: hover) and (pointer: fine) {
    .bento[data-arranged] > .tile {
      transition: opacity 600ms var(--ease-standard), transform 600ms var(--ease-standard), translate 220ms var(--ease-ui), box-shadow 220ms var(--ease-ui);
    }
    .bento[data-arranged]:not([data-sorting]) > .tile:hover {
      translate: 0 -2px;
      box-shadow: var(--room-hi), var(--room-float);
    }
  }

  .door-arrow {
    position: absolute;
    z-index: 4;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    color: var(--tile-ink-3);
    transition: color var(--t-micro) var(--ease-hover), transform var(--t-hover) var(--ease-hover);
  }
  .door-arrow--glass { top: 14px; right: 14px; background: rgb(22 23 25 / 0.5); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); color: var(--tile-ink-2); }
  .door-arrow :global(.icon) { width: 16px; height: 16px; }
  .tile:hover .door-arrow,
  .tile:focus-within .door-arrow { color: var(--accent-bright); transform: translate(4px, -4px); }
  .tile h3 { font-weight: inherit; }
  .tile__label { font-size: 0.8125rem; font-stretch: 92%; font-weight: 520; color: var(--tile-ink-3); }
  .panel {
    border-radius: var(--r-panel);
    background: linear-gradient(180deg, var(--room-3), #1e1f22);
    box-shadow: var(--room-hi), var(--room-float);
  }
  .glass {
    border-radius: var(--r-panel);
    background: rgb(22 23 25 / 0.55);
    -webkit-backdrop-filter: blur(18px) saturate(1.1);
    backdrop-filter: blur(18px) saturate(1.1);
    box-shadow: var(--room-hi), var(--room-float);
  }
  /* Pillola: larga quanto il contenuto, mai più della scheda; il testo va a capo, icona sempre visibile */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    min-height: 34px;
    min-width: 0;
    max-width: 100%;
    padding: 6px 14px 6px 12px;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--room-4), var(--room-3));
    box-shadow: var(--room-hi), var(--room-contact);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.25;
  }
  .pill__text { min-width: 0; overflow-wrap: anywhere; }
  .pill :global(.icon) { width: 15px; height: 15px; flex: none; opacity: 0.8; }
  .pill--glass { background: rgb(22 23 25 / 0.5); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
  .pill--quiet { min-height: 28px; padding: 4px 10px; font-size: 0.75rem; background: rgb(255 255 255 / 0.06); box-shadow: none; }
  .sq {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: var(--r-1);
    background: linear-gradient(180deg, var(--room-4), var(--room-3));
    box-shadow: var(--room-hi), var(--room-contact);
    color: var(--tile-ink-2);
  }
  .sq :global(.icon) { width: 16px; height: 16px; }
  .sq--btn { transition: color var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out); }
  .sq--btn:hover { color: var(--tile-ink); }
  .stretched { position: absolute; inset: 0; z-index: 5; border-radius: inherit; }
  .stretched:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }

  /* ---------- Stack (menu in flusso: la scheda cresce con il contenuto) ---------- */
  .t-stack { padding: 40px 18px 18px; }
  .t-stack__menu { position: relative; padding: 8px 8px 6px; }
  .t-stack__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 6px 8px 8px 10px; }
  .t-stack__head h3 { font-size: 0.9375rem; font-weight: 560; font-stretch: 104%; }
  .t-stack__group hr { border: 0; height: 1px; background: var(--tile-line); margin: 6px 4px; }
  .t-stack__label { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 4px 10px 2px; font-size: 0.75rem; font-weight: 520; font-stretch: 92%; color: var(--tile-ink-3); }
  .lvl { display: inline-flex; flex: none; gap: 3px; }
  .lvl i { width: 10px; height: 3px; border-radius: 2px; background: rgb(255 255 255 / 0.12); }
  .lvl[data-rank='3'] i,
  .lvl[data-rank='2'] i:nth-child(-n + 2),
  .lvl[data-rank='1'] i:first-child { background: var(--tile-ink-2); }
  .t-stack__group ul { display: flex; flex-wrap: wrap; gap: 2px 4px; padding: 4px 4px 2px; }
  .t-stack__group li { padding: 4px 7px; border-radius: var(--r-1); font-size: 0.875rem; color: var(--tile-ink); transition: background-color 240ms var(--ease-out); }
  .t-stack__group li:hover { background: rgb(255 255 255 / 0.06); box-shadow: inset 2px 0 0 var(--accent-bright); }
  .t-stack__more { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 6px; padding: 9px 10px; border-radius: 8px; background: rgb(255 255 255 / 0.04); font-size: 0.8125rem; color: var(--tile-ink-2); transition: color var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out); }
  .t-stack__more:hover { color: var(--tile-ink); background: rgb(255 255 255 / 0.07); }
  .t-stack__more :global(.icon) { width: 15px; height: 15px; flex: none; transition: color var(--t-micro) var(--ease-hover), transform var(--t-hover) var(--ease-hover); }
  .t-stack__more:hover :global(.icon),
  .t-stack__more:focus-visible :global(.icon) { color: var(--accent-bright); transform: translateY(3px); }

  /* ---------- Codice: la finestra sta dentro la scheda, il codice scorre al suo interno ---------- */
  .t-code { min-height: 250px; }
  .win { position: absolute; inset: 16px 0 0 16px; display: flex; flex-direction: column; min-width: 0; }
  .win__bar { display: flex; align-items: center; gap: 12px; min-width: 0; height: 36px; padding-left: 4px; }
  .win__dots { display: inline-flex; flex: none; gap: 6px; }
  .win__dots i { width: 9px; height: 9px; border-radius: 50%; background: rgb(255 255 255 / 0.14); }
  .win__tab,
  .win__title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.8125rem; font-weight: 500; color: var(--tile-ink-2); font-family: var(--mono); }
  .win__title { font-family: var(--font); }
  .win__badge { flex: none; margin-left: auto; margin-right: 14px; padding: 4px 10px; border-radius: 999px; background: rgb(255 255 255 / 0.06); font-size: 0.75rem; color: var(--tile-ink-2); white-space: nowrap; }
  .code {
    flex: 1;
    min-height: 0;
    margin-top: 8px;
    padding: 10px 0;
    border-radius: var(--r-panel) 0 0 0;
    background: linear-gradient(180deg, #151618, #121315);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05);
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.62;
    color: #d9dad7;
    overflow: auto;
    overscroll-behavior-x: contain;
    white-space: pre;
    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 0.2) transparent;
  }
  .code:focus-visible { outline-offset: -3px; }
  .code code { display: grid; min-width: max-content; }
  .ln { display: block; padding: 0 16px 0 0; }
  .ln__n { display: inline-block; width: 34px; padding-right: 12px; text-align: right; color: rgb(255 255 255 / 0.22); user-select: none; }
  .ln--hl { background: rgb(255 255 255 / 0.05); box-shadow: inset 0 0 0 1px rgb(220 222 210 / 0.22); border-radius: var(--r-1); margin-inline: 4px; }
  .ln--hl .ln__n { color: rgb(255 255 255 / 0.5); width: 30px; }
  .code :global(.caret) { display: inline-block; width: 2px; height: 1.15em; margin-left: 2px; vertical-align: -0.2em; background: var(--accent-bright); animation: caret 1.1s steps(1, end) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .code :global(.caret) { animation: none; } }
  .code :global(b) { font-weight: 650; color: #f2f2ef; }
  .code :global(i.c) { font-style: normal; color: rgb(255 255 255 / 0.36); }
  .code :global(s) { text-decoration: none; color: #c9c1ad; }
  @container (max-width: 300px) {
    .win__badge { display: none; }
    .code { font-size: 0.72rem; }
    .ln__n { width: 26px; padding-right: 8px; }
  }

  /* ---------- Ultima esperienza: il titolo va a capo, la descrizione non viene mai tagliata a metà ---------- */
  .t-recap { display: flex; flex-direction: column; padding: 20px 20px 22px; }
  .t-recap__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-width: 0; padding-right: 36px; }
  .t-recap__icons { display: inline-flex; gap: 8px; }
  .t-recap__title {
    margin-top: 20px;
    font-size: clamp(1.25rem, 1.05rem + 1.3cqi, 1.625rem);
    font-stretch: 112%;
    font-weight: 430;
    letter-spacing: -0.02em;
    line-height: 1.12;
    overflow-wrap: break-word;
    text-wrap: balance;
    transition: color var(--t-hover) var(--ease-hover);
  }
  .t-recap__text { margin-top: 10px; max-width: 46ch; font-size: 0.9375rem; line-height: 1.5; color: var(--tile-ink-2); }
  .t-recap .pill :global(.icon) { transition: color var(--t-micro) var(--ease-hover), opacity var(--t-micro) var(--ease-hover); }
  .t-recap:hover .t-recap__title,
  .t-recap:focus-within .t-recap__title { color: #fff; }
  .t-recap:hover .pill :global(.icon),
  .t-recap:focus-within .pill :global(.icon) { color: var(--accent-bright); opacity: 1; }
  /* Cella stretta: via le icone decorative, descrizione limitata a tre righe intere (con ellissi) */
  @container (max-width: 360px) {
    .t-recap__icons { display: none; }
    .t-recap__text { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; }
  }
  @container (max-width: 240px) {
    .t-recap__text { -webkit-line-clamp: 4; line-clamp: 4; }
  }

  /* ---------- Ritratto e disponibilità ---------- */
  .t-portrait { background: linear-gradient(180deg, #202125, #17181a); }
  .t-portrait__room {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(48% 34% at 50% 26%, rgb(236 236 233 / 0.14), transparent 72%),
      radial-gradient(70% 50% at 50% 100%, rgb(0 0 0 / 0.55), transparent 70%);
  }
  .t-portrait :global(picture) { position: absolute; inset: 0; z-index: 1; }
  .t-portrait :global(.t-portrait__img) {
    position: absolute;
    left: 50%;
    bottom: -13%;
    height: 113%;
    width: auto;
    max-width: none;
    transform: translateX(-50%);
    filter: drop-shadow(0 16px 20px rgb(0 0 0 / 0.5));
  }
  .t-portrait::before {
    content: '';
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 50%, rgb(10 11 12 / 0.6));
  }
  .t-portrait__loc { position: absolute; z-index: 3; top: 16px; left: 14px; max-width: calc(100% - 28px); }
  .t-portrait__card {
    position: absolute;
    z-index: 3;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 12px 13px;
    border-radius: var(--r-2);
    background: rgb(18 19 21 / 0.74);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08), 0 0 0 1px rgb(255 255 255 / 0.07);
  }
  .t-portrait__status { display: flex; align-items: center; gap: 8px; font-size: 0.875rem; font-weight: 560; }
  .t-portrait__text { margin-top: 3px; font-size: 0.8125rem; color: var(--tile-ink-2); line-height: 1.4; }
  /* I pulsanti vanno a capo o si impilano: non si contendono mai la larghezza */
  .t-portrait__row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 11px; }
  .t-portrait__row :global(.btn) { flex: 1 1 auto; min-width: 0; white-space: normal; text-align: center; }
  @container (max-width: 240px) {
    .t-portrait__row { flex-direction: column; }
  }

  /* ---------- Principale ---------- */
  .t-hello {
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(70% 90% at 0% 0%, rgb(255 255 255 / 0.05), transparent 60%),
      linear-gradient(180deg, var(--room-3), var(--tile));
  }
  .t-hello__big { font-size: clamp(1.6rem, 1.1rem + 3cqi, 2.5rem); font-stretch: 108%; font-weight: 380; letter-spacing: -0.03em; line-height: 1.08; max-width: 24ch; }
  .t-hello__big .dim { display: block; color: var(--tile-ink-2); }
  .t-hello__big strong { font-weight: 620; }
  /* Mini-schede: si adattano alla larghezza invece di uscire dalla scheda */
  .t-hello__cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 10px; margin-top: auto; padding-top: 22px; }
  .mini {
    --sig-r: 11px;
    display: grid;
    gap: 6px;
    height: 100%;
    padding: 12px 14px;
    border-radius: var(--r-panel);
    background: linear-gradient(180deg, var(--room-4), var(--room-3));
    box-shadow: var(--room-hi), var(--room-contact);
  }
  .mini:hover { transform: translateY(-2px); }
  .mini__top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 0.875rem; font-weight: 560; }
  .mini__name { min-width: 0; }
  .mini__year { flex: none; color: var(--tile-ink-3); font-weight: 500; font-variant-numeric: tabular-nums; transition: color var(--t-micro) var(--ease-hover); }
  .mini:hover .mini__year,
  .mini:focus-visible .mini__year { color: var(--accent-ink); }
  .mini__detail { font-size: 0.8125rem; color: var(--tile-ink-2); }
  .t-hello__cta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .t-hello__cta :global(.btn) { white-space: normal; min-width: 0; }

  /* ---------- Lingue: si ricompone in base alla larghezza reale della scheda ---------- */
  .t-lang { display: flex; padding: 22px 20px 20px; }
  .t-lang__in { flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 18px; min-width: 0; }
  .t-lang__pill {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    align-self: flex-start;
    max-width: 100%;
    margin-top: 8px;
    padding: 6px 20px 6px 6px;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--room-4), var(--room-3));
    box-shadow: var(--room-hi), var(--room-contact);
  }
  .t-lang__faces { display: flex; flex: none; }
  .t-lang__faces span {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    margin-left: -7px;
    background: radial-gradient(circle at 35% 30%, #6a6c70, #3a3b3f 70%);
    box-shadow: 0 0 0 3px var(--room-3), inset 0 1px 0 rgb(255 255 255 / 0.2);
    font-size: 0.9375rem;
    font-stretch: 112%;
    font-weight: 560;
    letter-spacing: -0.02em;
  }
  .t-lang__faces span:first-child { margin-left: 0; }
  .t-lang__faces span:nth-child(2) { background: radial-gradient(circle at 35% 30%, #8a8c90, #4b4c50 70%); }
  .t-lang__faces span:nth-child(3) { background: radial-gradient(circle at 35% 30%, #b3b5b7, #6b6d71 70%); color: #141516; }
  .t-lang__count { min-width: 0; font-size: 1.125rem; font-stretch: 108%; font-weight: 480; line-height: 1.2; }
  .t-lang__text { font-size: 0.875rem; line-height: 1.5; color: var(--tile-ink-2); }
  /* Stretta: lingue in alto, "3 lingue" sotto, descrizione in fondo */
  @container (max-width: 300px) {
    .t-lang__pill { flex-direction: column; align-items: flex-start; padding: 8px 16px 12px 8px; border-radius: 999px; }
    .t-lang__faces span { width: 40px; height: 40px; font-size: 0.875rem; }
  }
  /* Larga (striscia su tablet): pillola e testo sulla stessa riga */
  @container (min-width: 540px) {
    .t-lang__in { flex-direction: row; align-items: center; justify-content: space-between; gap: 24px; }
    .t-lang__pill { margin-top: 0; align-self: center; }
    .t-lang__text { max-width: 40ch; }
  }

  /* ---------- Formazione: pannelli a strati, in flusso ---------- */
  .t-photo { display: flex; flex-direction: column; justify-content: space-between; min-height: 236px; padding-top: 16px; }
  .t-photo :global(picture),
  .t-photo :global(.t-photo__img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .t-photo :global(.t-photo__img) {
    object-fit: cover;
    object-position: 60% 50%;
    filter: saturate(0.7) brightness(0.72) contrast(1.05);
    transition: transform 1400ms var(--ease-out), filter var(--t-large) var(--ease-hover);
  }
  .t-photo:hover :global(.t-photo__img) { transform: scale(1.02); filter: saturate(0.7) brightness(0.73) contrast(1.07); }
  .t-photo__veil { position: absolute; z-index: 1; inset: 0; pointer-events: none; background: radial-gradient(70% 80% at 50% 110%, rgb(10 10 10 / 0.6), transparent 70%); }
  .t-photo__tag { position: relative; z-index: 2; margin-left: 14px; max-width: calc(100% - 80px); }
  .t-photo__stack { position: relative; z-index: 2; margin: 52px 16% -14px 12%; }
  .t-photo__card { position: relative; padding: 16px 18px 28px; }
  .t-photo__card--back { position: absolute; inset: -30px -8% auto 14%; padding: 9px 16px 40px; opacity: 0.8; font-size: 0.8125rem; color: var(--tile-ink-2); }
  .t-photo__card--back p { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .t-photo__org { font-size: 0.8125rem; color: var(--tile-ink-2); }
  .t-photo__title { margin-top: 2px; font-size: 1.125rem; font-stretch: 108%; font-weight: 520; letter-spacing: -0.015em; line-height: 1.25; }
  .t-photo__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; margin-top: 10px; font-size: 0.875rem; color: var(--tile-ink-2); }
  @container (max-width: 460px) {
    .t-photo__stack { margin-inline: 12px; }
    .t-photo__card--back { inset: -30px 8px auto 22px; }
  }

  /* ---------- Curriculum: affiancato se c'è spazio, impilato altrimenti ---------- */
  .t-cv { display: flex; padding: 20px; }
  .t-cv__in {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    grid-template-areas: 'sheet text' 'sheet btn';
    grid-template-rows: 1fr auto;
    gap: 14px 18px;
  }
  .t-cv__sheets { grid-area: sheet; position: relative; align-self: center; height: 7.4rem; }
  .t-cv__text { grid-area: text; min-width: 0; }
  .t-cv__btn { grid-area: btn; justify-self: start; align-self: end; position: relative; z-index: 6; white-space: normal; }
  .t-cv__sheet {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    gap: 5px;
    padding: 12px 10px;
    border-radius: 4px;
    background: #f4f4f2;
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.7);
    transition: transform var(--motion-card) var(--ease-standard);
  }
  .t-cv__sheet b { width: 40%; height: 5px; margin-bottom: 4px; border-radius: 1px; background: #17181a; }
  .t-cv__sheet i { height: 2px; border-radius: 2px; background: #17181a; opacity: 0.2; }
  .t-cv__sheet i.a { width: 22%; background: #ff8d28; opacity: 1; }
