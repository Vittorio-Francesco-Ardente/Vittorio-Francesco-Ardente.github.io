---
/**
 * Apertura breve (solo prima visita della sessione, mai con "riduci movimento"):
 * VFA che emerge dall'orizzonte su una fotografia che cambia ogni settimana.
 */
import Monogram from './Monogram.astro';
import { profile } from '../data/profile';
import { useT, type Locale } from '../i18n';
interface Props {
  locale: Locale;
}
const t = useT(Astro.props.locale);
---

<div class="intro" data-intro-root aria-hidden="true">
  <picture class="intro__photo">
    <source type="image/avif" data-intro-avif />
    <source type="image/webp" data-intro-webp />
    <img alt="" data-intro-img decoding="async" fetchpriority="high" width="2400" height="1350" />
  </picture>
  <div class="intro__veil"></div>
  <p class="intro__sig">{profile.name}</p>
  <div class="intro__center">
    <div class="intro__clip"><Monogram id="intro" variant="letters" class="intro__letters" /></div>
    <span class="intro__horizon"></span>
  </div>
  <div class="intro__meta">
    <p class="intro__label">{t.intro.placeLabel}</p>
    <p class="intro__place" data-place="name"></p>
    <p data-place="where"></p>
    <p class="intro__coords" data-place="coords"></p>
    <p><time data-place="time">--:--</time> {t.intro.localTime}, <span data-place="date"></span></p>
  </div>
  <p class="intro__note" data-place="note"></p>
  <p class="intro__resume">{t.idle.resume}</p>
</div>

<style>
  .intro { display: none; }
  /* Riposo: la stessa apertura torna come sfondo, senza toccare la posizione nella pagina */
  .intro[data-idle] {
    display: block;
    position: fixed;
    z-index: 88;
    inset: 0;
    background: #0b0c0c;
    color: var(--tile-ink);
    overflow: hidden;
    cursor: pointer;
    opacity: 0;
    transition: opacity 240ms var(--ease-standard);
  }
  .intro[data-idle-in] { opacity: 1; }
  .intro[data-idle] .intro__clip :global(.intro__letters) { transform: none; animation: none; }
  .intro[data-idle] .intro__horizon { transform: translateX(-50%) scaleX(1); animation: none; }
  .intro[data-idle] .intro__sig,
  .intro[data-idle] .intro__meta,
  .intro[data-idle] .intro__note { opacity: 1; animation: none; }
  .intro__resume { display: none; }
  .intro[data-idle] .intro__resume {
    display: block;
    position: absolute;
    left: 50%;
    bottom: clamp(70px, 14vh, 130px);
    transform: translateX(-50%);
    font-size: 0.8125rem;
    font-stretch: 92%;
    letter-spacing: 0.02em;
    color: rgb(236 236 233 / 0.6);
  }
  :global(:root[data-intro='play']) .intro {
    display: block;
    position: fixed;
    z-index: 90;
    inset: 0;
    background: #0b0c0c;
    color: var(--tile-ink);
    overflow: hidden;
    cursor: pointer;
    clip-path: inset(0 0 0 0);
  }
  :global(:root[data-intro='play']) { overflow: hidden; }

  .intro__photo,
  .intro__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .intro__photo img {
    object-fit: cover;
    filter: grayscale(0.55) contrast(1.04) brightness(0.72);
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 1200ms var(--ease-out), transform 3200ms var(--ease-out);
  }
  .intro[data-photo-ready] .intro__photo img { opacity: 1; transform: scale(1); }
  .intro__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(80% 70% at 50% 45%, transparent, rgb(8 9 9 / 0.55)),
      linear-gradient(180deg, rgb(8 9 9 / 0.35), transparent 30%, transparent 55%, rgb(8 9 9 / 0.7));
  }

  .intro__sig {
    position: absolute;
    top: clamp(20px, 4vh, 36px);
    left: var(--gutter);
    font-size: 0.875rem;
    font-stretch: 110%;
    font-weight: 480;
    letter-spacing: -0.005em;
    opacity: 0;
    animation: intro-fade 900ms 500ms var(--ease-out) forwards;
  }

  .intro__center {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(46vw, 440px);
    transform: translate(-50%, -50%);
  }
  .intro__clip { overflow: hidden; padding-top: 4px; }
  .intro__clip :global(.intro__letters) {
    width: 100%;
    height: auto;
    transform: translateY(104%);
    animation: intro-rise 1150ms 250ms var(--ease-out) forwards;
  }
  .intro__horizon {
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 100vw;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
    transform: translateX(-50%) scaleX(0);
    animation: intro-draw 1300ms 100ms var(--ease-inout) forwards;
  }

  .intro__meta {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(22px, 5vh, 44px);
    display: grid;
    gap: 2px;
    font-size: 0.8125rem;
    font-stretch: 90%;
    font-weight: 480;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
    color: rgb(236 236 233 / 0.78);
    opacity: 0;
    animation: intro-fade 900ms 700ms var(--ease-out) forwards;
  }
  .intro__label { color: rgb(236 236 233 / 0.55); margin-bottom: 6px; }
  .intro__place {
    font-size: 1.375rem;
    font-stretch: 115%;
    font-weight: 380;
    letter-spacing: -0.02em;
    color: var(--tile-ink);
    margin-bottom: 2px;
  }
  .intro__note {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(22px, 5vh, 44px);
    max-width: 34ch;
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgb(236 236 233 / 0.72);
    text-align: right;
    opacity: 0;
    animation: intro-fade 900ms 850ms var(--ease-out) forwards;
  }

  /* Uscita: il sipario si alza verso l'alto */
  :global(:root[data-intro='play']) .intro[data-leaving] {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 1000ms var(--ease-inout);
  }
  .intro[data-leaving] .intro__center { transition: transform 1000ms var(--ease-inout); transform: translate(-50%, -80%); }

  @keyframes intro-rise { to { transform: translateY(0); } }
  @keyframes intro-draw { to { transform: translateX(-50%) scaleX(1); } }
  @keyframes intro-fade { to { opacity: 1; } }

  @media (max-width: 700px) {
    .intro__center { width: 62vw; top: 40%; }
    .intro__note { display: none; }
  }
</style>
