---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { placeForWeek, formatCoords } from '../data/places';
import { useT, fill, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
/* Foto predefinita = settimana della build; il client la aggiorna alla settimana corrente. */
const p = placeForWeek();
const pt = t.places[p.id];
const img = await getImage({ src: p.photo, width: 1600, format: 'webp', quality: 70 });
---

<section id="contatti" class="contact bleed" aria-labelledby="contact-title" data-section data-surface="dark">
  <picture class="contact__photo" data-place-picture>
    <source type="image/avif" data-place-avif />
    <source type="image/webp" data-place-webp />
    <img src={img.src} alt="" loading="lazy" decoding="async" width="1600" height="900" data-place-img />
  </picture>
  <div class="contact__veil" aria-hidden="true"></div>

  <div class="shell contact__inner">
    <div class="contact__main">
      <h2 id="contact-title" class="contact__title" data-reveal="title">{t.contact.title}</h2>
      <p class="contact__text">{t.contact.text}</p>
      <div class="contact__mail">
        <a class="contact__email u-grow" href={`mailto:${profile.contacts.email}`}>{profile.contacts.email}</a>
        <button class="contact__copy" type="button" data-copy={profile.contacts.email} data-copy-status="copy-status-contact" data-msg-ok={t.contact.copiedMsg} data-msg-fail={t.contact.copyFail} data-label-copy={t.contact.copy} data-label-done={t.contact.copied}>
          <Icon name="copy" />
          <span data-copy-label>{t.contact.copy}</span>
        </button>
        <span id="copy-status-contact" class="visually-hidden" role="status" aria-live="polite"></span>
      </div>
      <div class="contact__links">
        <a class="btn btn--signal" data-nudge="right" href={`mailto:${profile.contacts.email}`}><Icon name="mail" />{t.contact.writeEmail}</a>
        <a class="btn btn--dark" data-nudge="diag" href={profile.contacts.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" />LinkedIn</a>
        <a class="btn btn--dark" data-nudge="diag" href={profile.contacts.github} target="_blank" rel="noopener noreferrer"><Icon name="github" />GitHub</a>
        <button class="btn btn--dark" type="button" data-cv-open data-nudge="diag"><Icon name="doc" />{t.cv.open}</button>
      </div>
    </div>

    <aside class="contact__place" aria-label={t.contact.placeAria} data-reveal="fade">
      <p class="contact__label">{t.contact.placeLabel}</p>
      <p class="contact__place-name" data-place="name">{pt.name}</p>
      <p data-place="where">{pt.region}, {pt.country}</p>
      <p class="t-num" data-place="coords">{formatCoords(p.lat, p.lon, locales[locale].intl)}</p>
      <p><time class="t-num" data-place="time">--:--</time> {t.contact.localTime}, <span data-place="date"></span></p>
      <p class="contact__note" data-place="note">{pt.note}</p>
      <p class="contact__credit"><a data-place="credit" href={p.credit.source} target="_blank" rel="noopener noreferrer">{fill(t.contact.photoCredit, { author: p.credit.author, license: p.credit.license })}</a></p>
    </aside>
  </div>
</section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: max(720px, 100svh);
    display: flex;
    align-items: flex-end;
    /* in basso lascia il posto al Dock (18 + 64 px): i pulsanti non finiscono mai sotto la barra */
    padding-block: calc(var(--topbar) + 8vh) calc(100px + env(safe-area-inset-bottom));
    color: var(--tile-ink);
    background: #0b0c0c;
    overflow: hidden;
  }
  .contact__photo,
  .contact__photo img { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  .contact__photo img { object-fit: cover; filter: grayscale(0.5) contrast(1.04) brightness(0.7); }
  .contact__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(8 9 9 / 0.78), rgb(8 9 9 / 0.35) 55%, rgb(8 9 9 / 0.15)),
      linear-gradient(180deg, rgb(8 9 9 / 0.45), transparent 30%, transparent 60%, rgb(8 9 9 / 0.6));
  }
  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    align-items: end;
    gap: 48px 60px;
  }
  .contact__title {
    font-size: clamp(3.5rem, 10vw, 9.5rem);
    font-stretch: 125%;
    font-weight: 290;
    letter-spacing: -0.05em;
    line-height: 0.88;
  }
  .contact__text {
    margin-top: 28px;
    max-width: 36ch;
    font-size: var(--t-lede);
    line-height: 1.5;
    color: rgb(236 236 233 / 0.82);
  }
  .contact__mail { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 36px; }
  .contact__email {
    font-size: clamp(1.25rem, 2.6vw, 2.125rem);
    font-stretch: 108%;
    font-weight: 380;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    --line-strong: rgb(236 236 233 / 0.35);
    background-image: linear-gradient(var(--accent), var(--accent)), linear-gradient(var(--line-strong), var(--line-strong));
    background-size: 0% 1px, 100% 1px;
  }
  .contact__email:hover,
  .contact__email:focus-visible { background-size: 100% 1px, 100% 1px; }
  .contact__copy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    font-size: 0.8125rem;
    transition: background-color var(--dur) var(--ease-out);
  }
  .contact__copy:hover { background: rgb(255 255 255 / 0.14); }
  .contact__copy :global(.icon) { width: 15px; height: 15px; transition: color var(--t-micro) var(--ease-hover); }
  .contact__copy[data-copied] { box-shadow: inset 0 0 0 1px var(--accent-border); }
  .contact__copy[data-copied] :global(.icon) { color: var(--accent); }
  .contact__links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 36px; }
  /* icone di LinkedIn, GitHub, email e CV un filo più grandi: leggibili sul fondo fotografico */
  .contact__links :global(.btn svg) { width: 20px; height: 20px; }

  .contact__place {
    display: grid;
    gap: 2px;
    padding-left: 20px;
    border-left: 1px solid rgb(236 236 233 / 0.28);
    font-size: 0.8125rem;
    font-stretch: 92%;
    line-height: 1.55;
    color: rgb(236 236 233 / 0.76);
  }
  .contact__label { color: rgb(236 236 233 / 0.52); margin-bottom: 6px; }
  .contact__place-name {
    font-size: 1.375rem;
    font-stretch: 115%;
    font-weight: 380;
    letter-spacing: -0.02em;
    color: var(--tile-ink);
  }
  .contact__note { margin-top: 10px; font-stretch: 100%; line-height: 1.5; max-width: 32ch; }
  .contact__credit { margin-top: 12px; }
  .contact__credit a {
    color: rgb(236 236 233 / 0.6);
    background-image: linear-gradient(var(--accent), var(--accent)), linear-gradient(rgb(236 236 233 / 0.3), rgb(236 236 233 / 0.3));
    background-repeat: no-repeat;
    background-position: 0 100%, 0 100%;
    background-size: 0% 1px, 100% 1px;
    padding-bottom: 1px;
    transition: background-size var(--t-hover) var(--ease-hover), color var(--t-hover) var(--ease-hover);
  }
  .contact__credit a:hover,
  .contact__credit a:focus-visible { color: var(--tile-ink); background-size: 100% 1px, 100% 1px; }

  @media (max-width: 860px) {
    .contact__inner { grid-template-columns: 1fr; }
    .contact__place { padding-bottom: 8px; }
    .contact__links { gap: 8px; }
  }
</style>
