---
import Icon from './Icon.astro';
import { useT, type Locale } from '../i18n';
interface Props {
  locale: Locale;
}
const t = useT(Astro.props.locale);
---

<section id="domande" class="section faq" aria-labelledby="faq-title" data-section>
  <div class="shell faq__grid">
    <div class="faq__head">
      <h2 id="faq-title" class="t-h2" data-reveal="title">{t.faq.title}</h2>
      <p class="muted" data-reveal="fade">{t.faq.intro}</p>
    </div>
    <div class="faq__list">
      {
        t.faq.items.map((f, i) => (
          <details class="faq__item" name="faq" open={i === 0}>
            <summary>
              <span class="faq__q">{f.q}</span>
              <span class="faq__icon" aria-hidden="true"><Icon name="plus" /></span>
            </summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px clamp(16px, 2vw, 28px);
    align-items: start;
  }
  .faq__head { grid-column: 1 / span 4; position: sticky; top: calc(var(--topbar) + 32px); display: grid; gap: 18px; }
  .faq__head p { max-width: 30ch; }
  .faq__list { grid-column: 6 / span 7; border-top: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 0;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__q {
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    font-stretch: 106%;
    font-weight: 440;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .faq__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: transform 500ms var(--ease-out), background-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }
  .faq__icon :global(.icon) { width: 16px; height: 16px; }
  /* Aperta = attiva: cerchio pieno, croce arancio (forma + colore) */
  .faq__item[open] .faq__icon { transform: rotate(45deg); background: var(--ink); color: var(--accent-bright); border-color: var(--ink); }
  :global(:root[data-theme='dark']) .faq__item[open] .faq__icon { color: #c95000; }
  .faq__item summary:hover .faq__icon { border-color: var(--accent-border); }
  .faq__item[open] summary:hover .faq__icon { border-color: var(--ink); }
  .faq__a { padding: 0 60px 28px 0; color: var(--ink-2); max-width: 60ch; }
  .faq__item summary:focus-visible { outline-offset: 6px; }

  @media (max-width: 960px) {
    .faq__head,
    .faq__list { grid-column: 1 / -1; position: static; }
    .faq__a { padding-right: 0; }
  }
</style>
