---
/**
 * Curriculum Vitae — documento A4 stampabile, nella lingua della pagina.
 * Tema scelto dal dialogo del sito (?theme=light|dark), modificabile dalla barra.
 * Solo fatti verificati (src/data/*) + testi dei dizionari.
 */
import '../../styles/global.css';
import fontLatin from '@fontsource-variable/mona-sans/files/mona-sans-latin-standard-normal.woff2?url';
import Monogram from '../../components/Monogram.astro';
import Icon from '../../components/Icon.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import { profile } from '../../data/profile';
import { experiences } from '../../data/experiences';
import { byLevel, levelOrder } from '../../data/skills';
import { useT, locales, supportedLocales, defaultLocale, localizePath, localeStaticPaths, type Locale } from '../../i18n';
import { LOCALE_STORAGE_KEY } from '../../i18n/config';

export const getStaticPaths = localeStaticPaths;
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const site = Astro.site ?? new URL(profile.site);
const canonical = new URL(localizePath('/cv', locale), site).toString();
const internships = experiences.filter((e) => e.kind === 'internship');
const education = experiences.filter((e) => e.kind === 'education');
const short = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');
const nonDefault = supportedLocales.filter((l) => l !== defaultLocale);
const boot = `(function(){var d=document.documentElement;d.classList.add('js');try{var L=${JSON.stringify(nonDefault)},D='${defaultLocale}',p=location.pathname,s=localStorage.getItem('${LOCALE_STORAGE_KEY}'),c=d.getAttribute('lang');if(s&&s!==c&&(s===D||L.indexOf(s)>-1)){var g=p.split('/')[1],r=L.indexOf(g)>-1?(p.slice(g.length+1)||'/'):p,n=s===D?r:('/'+s+(r==='/'?'':r));if(n!==p){location.replace(n+location.search+location.hash);return}}var th=new URLSearchParams(location.search).get('theme');d.setAttribute('data-cv-theme',th==='dark'?'dark':'light')}catch(e){}})();`;
---

<!doctype html>
<html lang={locale} data-cv-theme="light" data-intl={locales[locale].intl}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.cv.metaTitle} — {profile.name}</title>
    <meta name="description" content={t.cv.metaDescription} />
    <link rel="canonical" href={canonical} />
    {supportedLocales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localizePath('/cv', l), site).toString()} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={boot} />
  </head>
  <body class="cv-body">
    <div class="cv-bar" role="toolbar" aria-label={t.cv.toolbar}>
      <a class="cv-bar__back" href={localizePath('/', locale)}><Icon name="arrowLeft" />{t.cv.back}</a>
      <div class="cv-bar__group">
        <LangSwitch locale={locale} path="/cv" />
        <div class="cv-seg" role="group" aria-label={t.cv.chooseTheme}>
          <button type="button" data-cv-theme-btn="light" aria-pressed="true">{t.cv.light}</button>
          <button type="button" data-cv-theme-btn="dark" aria-pressed="false">{t.cv.dark}</button>
        </div>
        <a class="btn btn--solid btn--sm" data-nudge="down" data-cv-download href={`/cv-pdf/${locale}-light.pdf`} download><Icon name="arrowDown" />{t.cv.download}</a>
        <details class="cv-more">
          <summary aria-label={t.cv.more}><Icon name="dots" /></summary>
          <div class="cv-more__panel">
            <button type="button" data-cv-print><Icon name="doc" />{t.cv.print}</button>
          </div>
        </details>
      </div>
    </div>

    <main class="cv-desk">
      <article class="sheet" aria-label={`${t.cv.title} — ${profile.name}`}>
        <header class="cv-head">
          <Monogram id="cv" class="cv-mark" />
          <div class="cv-id">
            <h1>{profile.name}</h1>
            <p class="cv-role">{t.cv.role}</p>
          </div>
          <ul class="cv-contacts" role="list">
            <li><Icon name="mail" /><a href={`mailto:${profile.contacts.email}`}>{profile.contacts.email}</a></li>
            <li><Icon name="linkedin" /><a href={profile.contacts.linkedin}>{short(profile.contacts.linkedin)}</a></li>
            <li><Icon name="github" /><a href={profile.contacts.github}>{short(profile.contacts.github)}</a></li>
            <li><Icon name="pin" />{t.cv.base}</li>
          </ul>
        </header>

        <div class="cv-cols">
          <div class="cv-main">
            <section class="cv-sec">
              <h2>{t.cv.sections.profile}</h2>
              <p class="cv-summary">{t.cv.summary}</p>
            </section>

            <section class="cv-sec">
              <h2>{t.cv.sections.experience}</h2>
              {
                internships.map((e) => {
                  const x = t.experiences.items[e.slug];
                  return (
                    <div class="cv-entry">
                      <div class="cv-entry__top">
                        <h3>{e.org}</h3>
                        <span class="cv-entry__when">{x.period}</span>
                      </div>
                      <p class="cv-entry__sub">{t.experiences.kinds.internship} · {x.area} · {e.place} · {e.hours} {t.experiences.hoursUnit}</p>
                      <ul class="cv-bullets">{x.activities.slice(0, 4).map((a) => <li><strong>{a.title}.</strong> {a.text}</li>)}</ul>
                    </div>
                  );
                })
              }
            </section>

            <section class="cv-sec">
              <h2>{t.cv.sections.education}</h2>
              {
                education.map((e) => {
                  const x = t.experiences.items[e.slug];
                  return (
                    <div class="cv-entry">
                      <div class="cv-entry__top">
                        <h3>{x.title}</h3>
                        <span class="cv-entry__when">{x.period}</span>
                      </div>
                      <p class="cv-entry__sub">{e.org} · {x.area} · {e.place}</p>
                      <ul class="cv-bullets">
                        <li><strong>{t.experiences.grade}:</strong> {e.grade}</li>
                        <li><strong>{t.bento.hackathon}:</strong> {'extraValue' in x ? x.extraValue : ''}</li>
                        <li>{x.keywords.join(', ')}.</li>
                      </ul>
                    </div>
                  );
                })
              }
            </section>
          </div>

          <aside class="cv-side">
            <section class="cv-sec">
              <h2>{t.cv.sections.skills}</h2>
              {
                levelOrder.map((lv) => (
                  <div class="cv-skill">
                    <h3>{t.profile.levels[lv].label}</h3>
                    <p>{byLevel(lv).map((s) => t.profile.skills[s.id]).join(', ')}</p>
                  </div>
                ))
              }
            </section>
            <section class="cv-sec">
              <h2>{t.cv.sections.languages}</h2>
              <ul class="cv-langs" role="list">
                {profile.languages.map((l) => (
                  <li>
                    <span>{t.cv.languageNames[l.code]}</span>
                    <span class="cv-langs__lvl">{t.cv.languageLevels[l.level]}</span>
                    <span class="cv-meter" data-level={l.level} aria-hidden="true"><i /><i /><i /><i /><i /><i /></span>
                  </li>
                ))}
              </ul>
            </section>
            <section class="cv-sec">
              <h2>{t.cv.sections.other}</h2>
              <ul class="cv-list" role="list">
                <li><span class="cv-dot" aria-hidden="true"></span>{t.availability.short}.</li>
                <li>{t.availability.remote}.</li>
                <li>{t.workModes.licence}.</li>
              </ul>
            </section>
          </aside>
        </div>

        <footer class="cv-foot">
          <span class="cv-foot__line" aria-hidden="true"></span>
          <span>{t.cv.updated}</span>
        </footer>
      </article>
    </main>

    <script>
      import '../../scripts/cv';
    </script>
  </body>
</html>

<style>
  :global(html[data-cv-theme]) { background: #d9dbd9; }
  :global(html[data-cv-theme='dark']) { background: #050606; }
  .cv-body { background: transparent; min-height: 100vh; color: #17181a; }
  :global(html[data-cv-theme='dark']) .cv-body { color: var(--tile-ink); }

  /* ---------- Barra (solo schermo) ---------- */
  .cv-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    padding: 12px clamp(12px, 3vw, 28px);
    background: color-mix(in oklab, #f2f1ed 82%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgb(10 10 10 / 0.1);
    color: #17181a;
    --ink: #161616; --paper: #f2f1ed; --line-strong: rgb(23 24 26 / 0.22); --accent: #c95000; --accent-bright: #ff8d28;
  }
  :global(html[data-cv-theme='dark']) .cv-bar {
    background: rgb(12 13 13 / 0.8);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.08);
    color: var(--tile-ink);
    --ink: var(--tile-ink); --paper: #0c0d0d; --line-strong: rgb(236 236 233 / 0.25); --accent: var(--room-accent); --accent-bright: #ffa056;
  }
  .cv-bar__back { display: inline-flex; align-items: center; gap: 8px; font-size: 0.875rem; }
  .cv-bar__back :global(.icon) { width: 16px; height: 16px; transition: transform var(--motion-ui) var(--ease-standard), color var(--motion-micro) var(--ease-standard); }
  .cv-bar__back:hover :global(.icon) { transform: translateX(-3px); color: var(--accent); }
  .cv-bar__group { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  /* Stampa: azione secondaria, dentro un piccolo menu */
  .cv-more { position: relative; }
  .cv-more summary {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    cursor: pointer;
    list-style: none;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .cv-more summary::-webkit-details-marker { display: none; }
  .cv-more summary :global(.icon) { width: 18px; height: 18px; }
  .cv-more[open] summary { box-shadow: inset 0 0 0 1px var(--accent-border); }
  .cv-more__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    max-width: calc(100vw - 24px);
    transform: translateX(var(--shift, 0px));
    padding: 6px;
    border-radius: var(--r-2);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line-strong), 0 12px 28px -12px rgb(0 0 0 / 0.4);
    z-index: 5;
  }
  .cv-more__panel button {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .cv-more__panel button:hover { background: color-mix(in oklab, currentColor 10%, transparent); }
  .cv-more__panel :global(.icon) { width: 16px; height: 16px; }
  .cv-seg { display: inline-flex; padding: 3px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line-strong); }
  .cv-seg button { position: relative; padding: 6px 12px; border-radius: 999px; font-size: 0.8125rem; opacity: 0.6; transition: opacity var(--motion-ui) var(--ease-standard), background-color var(--motion-ui) var(--ease-standard); }
  .cv-seg button[aria-pressed='true'] { opacity: 1; background: color-mix(in oklab, currentColor 10%, transparent); }
  .cv-seg button[aria-pressed='true']::after { content: ''; position: absolute; left: 50%; bottom: 2px; width: 10px; height: 2px; margin-left: -5px; border-radius: 2px; background: var(--accent-bright); }

  /* ---------- Foglio A4 ---------- */
  .cv-desk { padding: clamp(16px, 4vw, 48px) 12px 64px; display: grid; justify-items: center; }
  .sheet {
    --s-bg: #fbfbfa;
    --s-ink: #17181a;
    --s-ink-2: #4a4d50;
    --s-ink-3: #63676a;
    --s-line: rgb(23 24 26 / 0.12);
    --s-accent: #c95000;
    width: min(210mm, 100%);
    min-height: 297mm;
    padding: 15mm 15mm 12mm;
    display: flex;
    flex-direction: column;
    background: var(--s-bg);
    color: var(--s-ink);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 30px 60px -30px rgb(0 0 0 / 0.35);
    font-size: 9.4pt;
    line-height: 1.5;
  }
  :global(html[data-cv-theme='dark']) .sheet {
    --s-bg: #111213;
    --s-ink: var(--tile-ink);
    --s-ink-2: #b4b6b8;
    --s-ink-3: #8e9194;
    --s-line: rgb(236 236 233 / 0.12);
    --s-accent: var(--room-accent);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.06), 0 30px 60px -30px rgb(0 0 0 / 0.8);
  }
  .sheet a { color: inherit; }
  .cv-head { display: grid; grid-template-columns: auto 1fr auto; gap: 6mm; align-items: end; padding-bottom: 6mm; border-bottom: 1px solid var(--s-line); }
  .cv-head :global(.cv-mark) { width: 18mm; color: var(--s-ink); align-self: start; margin-top: 1mm; }
  .cv-id h1 { font-size: 21pt; font-stretch: 118%; font-weight: 330; letter-spacing: -0.035em; line-height: 1; }
  .cv-role { margin-top: 2mm; font-size: 10pt; color: var(--s-ink-2); }
  .cv-contacts { display: grid; gap: 1mm; font-size: 8.2pt; color: var(--s-ink-2); }
  .cv-contacts li { display: flex; align-items: center; gap: 2mm; }
  .cv-contacts :global(.icon) { width: 3.4mm; height: 3.4mm; color: var(--s-ink-3); }
  .cv-cols { display: grid; grid-template-columns: 1fr 58mm; gap: 9mm; padding-top: 6mm; flex: 1; }
  .cv-sec + .cv-sec { margin-top: 6mm; }
  .cv-sec h2 {
    position: relative;
    margin-bottom: 3mm;
    padding-top: 2.5mm;
    font-size: 8.4pt;
    font-stretch: 100%;
    font-weight: 620;
    letter-spacing: 0.04em;
    color: var(--s-ink);
  }
  /* Micro-accento VFA: segmento arancio sopra ogni titolo di sezione */
  .cv-sec h2::before { content: ''; position: absolute; left: 0; top: 0; width: 4mm; height: 0.6mm; border-radius: 1px; background: var(--s-accent); }
  .cv-summary { color: var(--s-ink-2); }
  .cv-entry { break-inside: avoid; }
  .cv-entry + .cv-entry { margin-top: 4mm; }
  .cv-entry__top { display: flex; justify-content: space-between; align-items: baseline; gap: 4mm; }
  .cv-entry__top h3 { font-size: 10.5pt; font-stretch: 106%; font-weight: 560; letter-spacing: -0.01em; }
  .cv-entry__when { font-size: 8.2pt; color: var(--s-ink-3); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .cv-entry__sub { margin-top: 0.5mm; font-size: 8.4pt; color: var(--s-ink-3); }
  .cv-bullets { margin-top: 1.8mm; padding-left: 3.5mm; display: grid; gap: 0.8mm; color: var(--s-ink-2); }
  .cv-bullets li::marker { color: var(--s-ink-3); }
  .cv-bullets strong { color: var(--s-ink); font-weight: 560; }
  .cv-skill + .cv-skill { margin-top: 3mm; }
  .cv-skill h3 { font-size: 8.6pt; font-weight: 600; }
  .cv-skill p { margin-top: 0.6mm; color: var(--s-ink-2); font-size: 8.4pt; line-height: 1.5; }
  .cv-langs { display: grid; gap: 2mm; }
  .cv-langs li { display: grid; grid-template-columns: 1fr auto; gap: 0.6mm 3mm; font-size: 8.6pt; }
  .cv-langs__lvl { color: var(--s-ink-3); font-size: 8.2pt; }
  .cv-meter { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1mm; }
  .cv-meter i { height: 0.6mm; border-radius: 1px; background: var(--s-line); }
  .cv-meter[data-level='native'] i,
  .cv-meter[data-level='b2'] i:nth-child(-n + 4) { background: var(--s-ink-2); }
  .cv-list { display: grid; gap: 1.2mm; color: var(--s-ink-2); font-size: 8.4pt; }
  .cv-list li { display: flex; gap: 2mm; align-items: baseline; }
  .cv-dot { width: 1.6mm; height: 1.6mm; border-radius: 50%; background: var(--s-accent); flex: none; transform: translateY(-0.3mm); }
  .cv-foot { display: flex; align-items: center; gap: 4mm; margin-top: 8mm; font-size: 7.6pt; color: var(--s-ink-3); }
  .cv-foot__line { flex: 1; height: 1px; background: var(--s-line); }

  @media (max-width: 760px) {
    .sheet { min-height: 0; padding: 22px 18px; font-size: 10pt; }
    .cv-head { grid-template-columns: auto 1fr; }
    .cv-contacts { grid-column: 1 / -1; }
    .cv-cols { grid-template-columns: 1fr; }
    .cv-more__panel { right: auto; left: 0; }
  }

  /* ---------- Stampa: solo il documento, A4 pulito ---------- */
  @media print {
    @page { size: A4; margin: 0; }
    .cv-more { display: none; }
    :global(html), :global(html[data-cv-theme]) { background: none; }
    .cv-bar { display: none; }
    .cv-desk { padding: 0; display: block; }
    .sheet {
      width: 210mm;
      min-height: 297mm;
      box-shadow: none;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .sheet * { transition: none !important; animation: none !important; }
  }
</style>
