---
import Legal from '../../layouts/Legal.astro';
import { useT, localeStaticPaths, type Locale } from '../../i18n';
export const getStaticPaths = localeStaticPaths;
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = useT(locale).legal.terms;
---

<Legal locale={locale} path="/terms" title={d.title} description={d.description} lead={d.lead} sections={d.sections} />
